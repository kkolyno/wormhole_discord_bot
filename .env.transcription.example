# EXAMPLE ONLY. No deployment/login is performed by development tools.
# Strict opt-in: only exactly true enables this feature instead of legacy meetings.
LOCAL_TRANSCRIPTION_ENABLED=false
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
VOICE_CHANNEL_ID=
ALERTS_CHANNEL_ID=
LOCAL_TRANSCRIPTION_DATA_DIR=/data/transcription
# Private persistent volume, owner UID1001, mode0700; one OS-flock writer.
# Set container stop_grace_period >=35s (global application deadline is 30s).
LOCAL_TRANSCRIPTION_EMPTY_GRACE_SECONDS=90
LOCAL_TRANSCRIPTION_MAX_SESSION_SECONDS=14400
LOCAL_TRANSCRIPTION_MAX_DRAIN_SECONDS=300
# Default OFF; change only after explicit user approval to publish transcript files.
LOCAL_TRANSCRIPT_ATTACHMENTS=false
# Image supplies pinned CPU-only whisper.cpp + English base.en, no runtime download.
WHISPER_CLI=/usr/local/bin/whisper-cli
WHISPER_MODEL=/opt/models/ggml-base.en.bin
FFMPEG_PATH=/usr/bin/ffmpeg
# Never configure external STT credentials. Do not enable private speech logging.
