# Pinned, previously validated ARM64 CPU whisper.cpp + base.en artifacts.
# Reuse native artifacts economically; do not inherit the old app/tools/dependencies.
FROM ghcr.io/kkolyno/wormhole_discord_bot@sha256:b281ad7f705f13fb2998c8cb5ee536a1a4beac2f26c894e8a7baff3d9adf650a AS validated-native
FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS runtime
WORKDIR /app
RUN test "$(uname -m)" = aarch64 \
 && apk add --no-cache ffmpeg libstdc++ libgcc tini util-linux \
 && /usr/bin/flock --version | grep util-linux \
 && addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001 -G nodejs \
 && mkdir -p /data/transcription && chmod 700 /data/transcription && chown -R 1001:1001 /data
COPY --from=validated-native /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=validated-native /usr/local/lib/ /usr/local/lib/
COPY --from=validated-native /opt/models/ /opt/models/
COPY --from=validated-native /usr/share/licenses/ /usr/share/licenses/
COPY --from=validated-native /usr/share/oracle-test-image/ /usr/share/transcription-image/
ENV LD_LIBRARY_PATH=/usr/local/lib \
    LOCAL_TRANSCRIPTION_DATA_DIR=/data/transcription \
    WHISPER_CLI=/usr/local/bin/whisper-cli \
    WHISPER_MODEL=/opt/models/ggml-base.en.bin \
    FFMPEG_PATH=/usr/bin/ffmpeg
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY index.js ./
COPY src/ ./src/
COPY test/local-transcription/*.test.js ./test/local-transcription/
COPY tools/local-transcription-image/preflight.sh tools/local-transcription-image/public-helper.js ./tools/local-transcription-image/
RUN test "$(node -p 'process.versions.node')" = 22.22.0 \
 && test "$(wc -c < /opt/models/ggml-base.en.bin)" -eq 147964211 \
 && echo 'a03779c86df3323075f5e796cb2ce5029f00ec8869eee3fdfb897afe36c6d002  /opt/models/ggml-base.en.bin' | sha256sum -c - \
 && ! ldd /usr/local/bin/whisper-cli 2>&1 | grep -E 'not found|Error loading|Error relocating' \
 && env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 /usr/local/bin/whisper-cli --help >/dev/null 2>&1
USER nodejs
# Opt-in is deliberately NOT set by this image. Configure >=35s container stop grace.
ENTRYPOINT ["/sbin/tini", "--", "docker-entrypoint.sh"]
CMD ["node", "index.js"]
